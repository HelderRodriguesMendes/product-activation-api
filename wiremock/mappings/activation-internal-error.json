
{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.externalId",
          "equalTo": "EXT-500"
        }
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": false,
      "message": "Internal provider error"
    }
  }
}