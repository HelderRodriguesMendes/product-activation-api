
{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.externalId",
          "equalTo": "EXT-TIMEOUT"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 5000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "message": "Product activated successfully"
    }
  }
}
